---
import Layout from "../layouts/Layout.astro";
import Pembuka from "../components/bab/Pembuka.astro";
import Sabana from "../components/bab/Sabana.astro";
import TanpaDokumentasi from "../components/bab/TanpaDokumentasi.astro";
import Puncak from "../components/bab/Puncak.astro";
import LangitCerah from "../components/bab/LangitCerah.astro";
import Sunrise from "../components/bab/Sunrise.astro";
import Penutup from "../components/bab/Penutup.astro";

import mediaData from "../data/media.json";
import { responsiveImage } from "../lib/media";

// Map slides per chapter
interface MediaItemRaw {
  jenis: string;
  berkas: string;
  poster?: string;
  judul?: string;
  caption: string;
  alt: string;
  fokus?: string;
  tampil?: string;
}

const getSlidesForBab = (babId: string) => {
  const bab = mediaData.find((b) => b.id === babId);
  if (!bab) return [];
  return bab.items.filter(item => item.publik && (item.jenis === "foto" || item.jenis === "video")).map((item: MediaItemRaw) => {
    if (item.jenis === "video") {
      const posterImg = item.poster ? responsiveImage(item.poster) : undefined;
      return {
        jenis: "video" as const,
        videoSrc: item.berkas,
        image: posterImg?.image,
        srcSet: posterImg?.srcSet,
        width: posterImg?.width,
        height: posterImg?.height,
        tampil: (item.tampil as "carousel" | "grid" | "keduanya") || "grid",
        title: item.judul || item.caption,
        caption: item.caption,
        alt: item.alt,
        fokus: item.fokus,
      };
    }
    return {
      jenis: "foto" as const,
      ...responsiveImage(item.berkas),
      tampil: (item.tampil as "carousel" | "grid" | "keduanya") || "keduanya",
      title: item.judul || item.caption,
      caption: item.caption,
      alt: item.alt,
      fokus: item.fokus,
    };
  });
};

const sabanaSlides = getSlidesForBab("sabana");
const puncakSlides = getSlidesForBab("puncak");
const langitSlides = getSlidesForBab("langit-cerah");
const sunriseSlides = getSlidesForBab("sunrise");
---

<Layout>
  <!-- Bab 00: Pembuka -->
  <Pembuka />

  <!-- Bab 01: Sabana -->
  <Sabana slides={sabanaSlides} />

  <!-- Bab 02: Tanpa Dokumentasi -->
  <TanpaDokumentasi />

  <!-- Bab 03: Puncak -->
  <Puncak slides={puncakSlides} />

  <!-- Bab 04: Langit Cerah -->
  <LangitCerah slides={langitSlides} />

  <!-- Bab 05: Sunrise -->
  <Sunrise slides={sunriseSlides} />

  <!-- Bab 06: Penutup -->
  <Penutup />
</Layout>
