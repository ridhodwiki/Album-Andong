---
interface Props {
  basecampMdpl?: number;
  puncakMdpl?: number;
}

const { basecampMdpl = 1300, puncakMdpl = 1726 } = Astro.props;
---

<!-- Desktop Side Elevation Rail -->
<aside
  id="rel-ketinggian-desktop"
  class="fixed left-6 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-center gap-3 select-none pointer-events-none transition-opacity duration-500 opacity-90"
  aria-hidden="true"
>
  <div class="flex flex-col items-center text-[10px] tracking-widest font-mono text-amber-200/80 uppercase">
    <span>Puncak</span>
    <span class="font-bold text-amber-100">{puncakMdpl} m</span>
  </div>

  <div class="relative w-[2px] h-48 bg-white/15 rounded-full overflow-hidden my-1">
    <div
      id="meter-progress-bar"
      class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-amber-400 via-emerald-400 to-sky-400 rounded-full transition-all duration-150"
      style="height: 0%;"
    ></div>
  </div>

  <div class="flex flex-col items-center text-[10px] tracking-widest font-mono text-white/50 uppercase">
    <span>Sawit</span>
    <span>{basecampMdpl} m</span>
  </div>

  <!-- Live Dynamic Indicator Pill -->
  <div
    class="mt-1 px-2.5 py-1 rounded bg-black/60 border border-white/10 backdrop-blur-sm flex items-center gap-1.5 shadow-lg"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
    <span id="live-elevasi-angka" class="font-mono text-xs font-semibold text-amber-200 tabular-nums">
      {basecampMdpl} mdpl
    </span>
  </div>
</aside>

<!-- Mobile Floating Elevation Pill -->
<div
  id="rel-ketinggian-mobile"
  class="fixed bottom-4 left-4 z-40 lg:hidden px-3 py-1.5 rounded-full bg-black/75 border border-white/15 backdrop-blur-md flex items-center gap-2 shadow-xl select-none"
  aria-label="Indikator Ketinggian Pendakian"
>
  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
  <span id="live-elevasi-mobile" class="font-mono text-xs font-medium text-amber-100 tabular-nums">
    {basecampMdpl} mdpl
  </span>
</div>

<script define:vars={{ basecampMdpl, puncakMdpl }}>
  function updateElevation() {
    const bar = document.getElementById("meter-progress-bar");
    const labelDesktop = document.getElementById("live-elevasi-angka");
    const labelMobile = document.getElementById("live-elevasi-mobile");

    const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (scrollHeight <= 0) return;

    const progress = Math.min(Math.max(window.scrollY / scrollHeight, 0), 1);
    const currentElevation = Math.round(basecampMdpl + progress * (puncakMdpl - basecampMdpl));

    if (bar) bar.style.height = `${progress * 100}%`;
    if (labelDesktop) labelDesktop.textContent = `${currentElevation} mdpl`;
    if (labelMobile) labelMobile.textContent = `${currentElevation} mdpl`;
  }

  window.addEventListener("scroll", updateElevation, { passive: true });
  window.addEventListener("resize", updateElevation);
  updateElevation();
</script>
