---
interface Props {
  basecampMdpl?: number;
  puncakMdpl?: number;
}

const { basecampMdpl = 1300, puncakMdpl = 1726 } = Astro.props;
---

<!-- Desktop Side Elevation Rail -->
<aside
  id="rel-ketinggian-desktop"
  class="fixed left-6 top-1/2 -translate-y-1/2 z-40 hidden lg:flex flex-col items-center gap-3 select-none pointer-events-none transition-opacity duration-500 opacity-90"
  aria-hidden="true"
>
  <div class="flex flex-col items-center text-xs tracking-widest font-mono text-amber-100 uppercase">
    <span>Puncak</span>
    <span class="font-bold text-amber-200">{puncakMdpl} m</span>
  </div>

  <div class="relative w-[3px] h-48 bg-white/20 rounded-full overflow-hidden my-1">
    <div
      id="meter-progress-bar"
      class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-amber-400 via-emerald-400 to-sky-400 rounded-full transition-all duration-150"
      style="height: 100%;"
    ></div>
  </div>

  <div class="flex flex-col items-center text-xs tracking-widest font-mono text-amber-100 uppercase">
    <span>Sawit</span>
    <span>{basecampMdpl} m</span>
  </div>

  <!-- Live Dynamic Indicator Pill -->
  <div
    class="mt-1 px-2.5 py-1 rounded bg-stone-950 border border-white/20 flex items-center gap-1.5 shadow-lg"
  >
    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
    <span id="live-elevasi-angka" class="font-mono text-xs font-semibold text-amber-200 tabular-nums">
      {puncakMdpl} mdpl
    </span>
  </div>
</aside>

<!-- Mobile Floating Elevation Pill -->
<div
  id="rel-ketinggian-mobile"
  class="fixed bottom-4 left-4 z-40 lg:hidden min-h-11 px-3.5 py-2 rounded-full bg-stone-950 border border-white/25 flex items-center gap-2 shadow-xl select-none"
  data-base={basecampMdpl}
  data-summit={puncakMdpl}
  aria-label="Indikator Ketinggian Pendakian"
>
  <span class="w-2 h-2 rounded-full bg-amber-400" aria-hidden="true"></span>
  <span id="live-elevasi-mobile" class="font-mono text-xs font-medium text-amber-100 tabular-nums">
    {puncakMdpl} mdpl
  </span>
</div>

