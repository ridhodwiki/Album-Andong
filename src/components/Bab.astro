---
interface Props {
  id: string;
  nomor?: string;
  nama?: string;
  subjudul?: string;
  elevasi?: string;
  tema?: "pembuka" | "sabana" | "gelap" | "puncak" | "langit" | "sunrise" | "penutup";
  className?: string;
}

const {
  id,
  nomor,
  nama,
  subjudul,
  elevasi,
  tema = "sabana",
  className = "",
} = Astro.props;
---

<section
  id={id}
  data-tema={tema}
  class={`relative w-full py-20 md:py-28 px-4 sm:px-6 md:px-12 overflow-hidden bg-transparent ${className}`}
  style="color: var(--teks);"
>
  <div class="max-w-6xl mx-auto flex flex-col items-center">
    <!-- Chapter Header (if provided) -->
    {(nomor || nama || subjudul) && (
      <header class="text-center max-w-2xl mx-auto mb-10 md:mb-14 data-muncul">
        {nomor && (
          <span
            data-bab-badge
            data-bab-nomor={nomor}
            data-bab-elevasi={elevasi || ""}
            class="inline-block font-mono text-xs uppercase tracking-widest text-[var(--teks)] mb-2 font-semibold px-3.5 py-1 rounded-full border border-[var(--border-subtle)]"
          >
            Bab {nomor} {elevasi ? `• ${elevasi}` : ""}
          </span>
        )}
        {nama && (
          <h2 data-i18n={`${id}.nama`} class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-[var(--teks)] mb-3">
            {nama}
          </h2>
        )}
        {subjudul && (
          <p data-i18n={`${id}.subjudul`} class="font-sans text-base text-[var(--teks-muted)] font-normal leading-relaxed">
            {subjudul}
          </p>
        )}
        <div class="w-12 h-0.5 mx-auto mt-4 bg-[var(--aksen)] opacity-50 rounded-full"></div>
      </header>
    )}

    <svg aria-hidden="true" class="w-24 h-8 mb-6" viewBox="0 0 100 32"><path data-trail d="M4 28 Q30 25 48 16 T96 4" fill="none" stroke="currentColor" stroke-width="2" /></svg>

    <slot />
  </div>
</section>
