---
import mediaData from "../../data/media.json";
import { responsiveImage } from "../../lib/media";
// Bab 00: Pembuka (Hero Editorial)
const bab = mediaData.find(b => b.id === "pembuka")!;
const tanggal = (bab as { tanggal?: string | null }).tanggal;
const cover = bab.items.find(item => item.publik);
const image = cover ? responsiveImage(cover.berkas) : null;

---

<header
  id="pembuka"
  data-tema="pembuka"
  class="relative min-h-svh w-full flex flex-col justify-between items-center text-center px-4 py-8 sm:py-12 overflow-hidden select-none"
>
  {image && cover && <img
    id="hero-bg"
    src={image.image}
    srcset={image.srcSet}
    sizes="100vw"
    width="1920"
    height="1080"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    alt={cover.alt}
    class="absolute inset-0 h-full w-full object-cover opacity-35"
  />}
  <div class="absolute inset-0 bg-gradient-to-b from-[#0F1A14]/80 via-[#0F1A14]/65 to-[#0F1A14]/90 pointer-events-none" aria-hidden="true"></div>

  <!-- Top Minimalist Meta -->
  <div class="relative z-10 w-full max-w-5xl flex flex-col sm:flex-row justify-between sm:items-center text-xs font-mono tracking-widest text-[#E8C872] uppercase pt-2 sm:pt-4 pr-36 sm:pr-0 font-medium text-left sm:text-center">
    <span>Gunung Andong • 1.726 mdpl</span>
    <span class="hidden sm:inline">Magelang, Jawa Tengah</span>
  </div>

  <!-- Center Editorial Title Hero -->
  <div class="relative z-10 max-w-3xl mx-auto my-auto py-12 flex flex-col items-center">
    <span lang="en" class="font-mono text-xs md:text-sm tracking-[0.25em] text-[#E8C872] uppercase mb-3 font-semibold">
      Notes from a hike together
    </span>

    <h1
      id="hero-title"
      aria-label="Andong, Berdua"
      class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-tight text-[#F4F1E8] leading-[1.05]"
    >
      Andong, Berdua
    </h1>

    <p lang="en" class="font-serif italic text-xl sm:text-2xl md:text-3xl text-[#E8C872] font-light mt-4 mb-6">
      {bab.judul}
    </p>

    <div class="bg-[#0F1A14]/85 px-6 py-4 rounded-xl border border-[#E8C872]/35 shadow-md max-w-xl mx-auto">
      <p lang="en" class="font-sans text-base text-[#F4F1E8] font-normal leading-relaxed">
        {bab.kutipan}
      </p>
    </div>
  </div>

  {tanggal && <time class="relative z-10 text-base" datetime={tanggal}>{tanggal}</time>}

  <!-- Bottom Scroll Cue -->
  <div class="relative z-10 flex flex-col items-center gap-2 pb-6">
    <span class="font-mono text-xs tracking-widest text-[#E8C872] uppercase font-medium">
      Gulir Untuk Memulai
    </span>
    <div class="w-5 h-9 rounded-full border border-[#E8C872] flex items-start justify-center p-1" aria-hidden="true">
      <div id="hero-scroll-dot" class="w-1.5 h-2 rounded-full bg-[#E8C872] mt-1"></div>
    </div>
  </div>
</header>
