---
// Bab 00: Pembuka (Hero Editorial)
---

<header
  id="pembuka"
  data-tema="pembuka"
  class="relative min-h-svh w-full flex flex-col justify-between items-center text-center px-4 py-8 sm:py-12 overflow-hidden select-none bg-transparent"
>
  <img src="/foto/responsive/sabana-02-1200.webp" srcset="/foto/responsive/sabana-02-600.webp 600w, /foto/responsive/sabana-02-1200.webp 1200w, /foto/responsive/sabana-02-1920.webp 1920w" sizes="100vw" width="1920" height="1080" fetchpriority="high" loading="eager" alt="Panorama Gunung Andong" class="absolute inset-0 h-full w-full object-cover opacity-20" />
  <!-- Top Minimalist Meta -->
  <div class="relative z-10 w-full max-w-5xl flex flex-col sm:flex-row justify-between sm:items-center text-[10px] sm:text-[11px] font-mono tracking-widest text-sky-900 uppercase pt-2 sm:pt-4 pr-32 sm:pr-0 font-medium text-left sm:text-center">
    <span>Gunung Andong • 1.726 mdpl</span>
    <span class="hidden sm:inline">Magelang, Jawa Tengah</span>
  </div>

  <!-- Center Editorial Title Hero -->
  <div class="relative z-10 max-w-3xl mx-auto my-auto py-12 flex flex-col items-center">
    <span class="font-mono text-xs md:text-sm tracking-[0.25em] text-sky-900 uppercase mb-3 font-semibold">
      Notes from a hike together
    </span>

    <h1
      id="hero-title"
      class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-tight text-slate-900 leading-[1.05] drop-shadow-[0_2px_20px_rgba(255,255,255,0.85)]"
    >
      Andong, Berdua
    </h1>

    <p lang="en" class="font-serif italic text-xl sm:text-2xl md:text-3xl text-sky-950 font-light mt-4 mb-6 drop-shadow-xs">
      A morning on Andong
    </p>

    <div class="backdrop-blur-sm bg-white/45 px-6 py-4 rounded-xl border border-white/60 shadow-xs max-w-xl mx-auto">
      <p lang="en" class="font-sans text-base text-slate-800 font-light leading-relaxed">
        "An early start, a cold trail, and a morning on Andong together."
      </p>
    </div>
  </div>

  <!-- Bottom Scroll Cue -->
  <div class="relative z-10 flex flex-col items-center gap-2 pb-6 opacity-90 transition hover:opacity-100">
    <span class="font-mono text-[10px] sm:text-xs tracking-widest text-sky-900 uppercase font-medium">
      Gulir Untuk Memulai
    </span>
    <div class="w-5 h-9 rounded-full border border-sky-800 flex items-start justify-center p-1" aria-hidden="true">
      <div class="w-1 h-2 rounded-full bg-sky-800 animate-bounce mt-1"></div>
    </div>
  </div>
</header>
