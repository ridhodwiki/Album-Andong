---
import mediaData from "../../data/media.json";
// Bab 00: Pembuka (Hero Editorial di atas Vanta Clouds 3D)
const bab = mediaData.find(b => b.id === "pembuka")!;
const tanggal = (bab as { tanggal?: string | null }).tanggal;
---

<header
  id="pembuka"
  data-tema="pembuka"
  class="relative min-h-svh w-full flex flex-col justify-between items-center text-center px-4 py-8 sm:py-12 overflow-hidden select-none bg-transparent"
>
  <!-- Top Minimalist Meta -->
  <div class="relative z-10 w-full max-w-5xl flex flex-col sm:flex-row justify-between sm:items-center text-xs font-mono tracking-widest text-sky-950 uppercase pt-2 sm:pt-4 pr-36 sm:pr-0 font-semibold text-left sm:text-center">
    <span class="px-3 py-1 rounded-full bg-white/55 backdrop-blur-xs border border-white/70 shadow-2xs">Gunung Andong • 1.726 mdpl</span>
    <span class="hidden sm:inline px-3 py-1 rounded-full bg-white/55 backdrop-blur-xs border border-white/70 shadow-2xs">Magelang, Jawa Tengah</span>
  </div>

  <!-- Center Editorial Title Hero -->
  <div class="relative z-10 max-w-3xl mx-auto my-auto py-12 flex flex-col items-center">
    <span lang="en" class="font-mono text-xs md:text-sm tracking-[0.25em] text-sky-950 uppercase mb-3 font-semibold px-3.5 py-1 rounded-full bg-white/50 backdrop-blur-xs border border-white/60">
      Notes from a hike together
    </span>

    <h1
      id="hero-title"
      aria-label="Andong, Berdua"
      class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal tracking-tight text-slate-900 leading-[1.05] drop-shadow-[0_2px_20px_rgba(255,255,255,0.85)]"
    >
      Andong, Berdua
    </h1>

    <p lang="en" class="font-serif italic text-xl sm:text-2xl md:text-3xl text-sky-950 font-normal mt-4 mb-6 drop-shadow-[0_1px_10px_rgba(255,255,255,0.75)]">
      {bab.judul}
    </p>

    <div class="backdrop-blur-md bg-white/65 px-6 py-4 rounded-xl border border-white/80 shadow-sm max-w-xl mx-auto">
      <p lang="en" class="font-sans text-base text-slate-900 font-normal leading-relaxed">
        "{bab.kutipan}"
      </p>
    </div>
  </div>

  {tanggal && <time class="relative z-10 text-base text-slate-900 font-mono" datetime={tanggal}>{tanggal}</time>}

  <!-- Bottom Scroll Cue -->
  <div class="relative z-10 flex flex-col items-center gap-2 pb-16 lg:pb-6">
    <span class="font-mono text-xs tracking-widest text-sky-950 uppercase font-semibold px-3 py-1 rounded-full bg-white/50 backdrop-blur-xs">
      Gulir Untuk Memulai
    </span>
    <div class="w-5 h-9 rounded-full border-2 border-sky-900 bg-white/40 backdrop-blur-xs flex items-start justify-center p-1" aria-hidden="true">
      <div id="hero-scroll-dot" class="w-1.5 h-2 rounded-full bg-sky-900 mt-1"></div>
    </div>
  </div>
</header>
