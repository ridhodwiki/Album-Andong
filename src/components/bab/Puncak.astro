---
import { responsiveImage } from "../../lib/media";
import mediaData from "../../data/media.json";
import Bab from "../Bab.astro";
import Galeri from "../Galeri";
import Video from "../Video.astro";
import type { Slide } from "../ui/polaroid-line-carousel";

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const bab = mediaData.find(b => b.id === "puncak")!;
const panorama = bab.items.find(item => item.publik);

---

<Bab
  id="puncak"
  nomor="03"
  nama="Puncak"
  subjudul={bab.subjudul}
  elevasi="1.726 mdpl"
  tema="puncak"
>
  <!-- Achievement Banner -->
  <div class="w-full max-w-4xl mx-auto text-center mb-12">
    <blockquote lang="en" class="font-serif italic text-xl sm:text-2xl text-[var(--teks)] max-w-xl mx-auto mb-6 font-light">{bab.kutipan}</blockquote>

    <!-- Milestone Pos Checkpoints Trail -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 max-w-3xl mx-auto my-6 text-left">
      <div class="p-3 rounded bg-white/80 border border-stone-400/50 shadow-xs">
        <span class="block text-xs font-mono uppercase text-stone-800">01. Basecamp</span>
        <span class="font-bold text-sm text-stone-950">1.300 mdpl</span>
      </div>
      <div class="p-3 rounded bg-white/80 border border-stone-400/50 shadow-xs">
        <span class="block text-xs font-mono uppercase text-stone-800">02. Pos 1 Kemuning</span>
        <span class="font-bold text-sm text-stone-950">1.420 mdpl</span>
      </div>
      <div class="p-3 rounded bg-white/80 border border-stone-400/50 shadow-xs">
        <span class="block text-xs font-mono uppercase text-stone-800">03. Pos 2 Dewandaru</span>
        <span class="font-bold text-sm text-stone-950">1.540 mdpl</span>
      </div>
      <div class="p-3 rounded bg-white/80 border border-stone-400/50 shadow-xs">
        <span class="block text-xs font-mono uppercase text-stone-800">04. Watu Belah</span>
        <span class="font-bold text-sm text-stone-950">1.680 mdpl</span>
      </div>
      <div class="p-3 rounded bg-amber-200 border border-amber-500 shadow-sm col-span-2 sm:col-span-1">
        <span class="block text-xs font-mono uppercase text-stone-900 font-bold">05. Puncak Andong</span>
        <span id="puncak-counter-target" class="font-bold text-sm text-stone-950 tabular-nums">1.726 mdpl ✓</span>
      </div>
    </div>
  </div>

  <!-- Featured Puncak Video / Poster Section -->
  {panorama && <div id="panorama-puncak" class="w-full max-w-4xl mx-auto mb-12 overflow-hidden">
    <Video
      poster={responsiveImage(panorama.berkas).image}
      alt={panorama.alt}
      caption={panorama.caption}
      className="w-full max-h-[75svh]"
    />
  </div>

  }

  <!-- Interactive React Island Galeri -->
  <Galeri
    client:visible
    slides={slides}
    tampil="keduanya"
    background="transparent"
    ink="#10233A"
    string="#1F4E79"
    ariaLabel="Galeri Foto Puncak Gunung Andong"
  />
</Bab>
