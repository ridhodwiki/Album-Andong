---
import Bab from "../Bab.astro";
import Galeri from "../Galeri";
import type { Slide } from "../ui/polaroid-line-carousel";

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<Bab
  id="sunset"
  nomor="05"
  nama="Sunset"
  subjudul="The Last Light"
  elevasi="1.726 mdpl"
  tema="sunset"
  className="relative"
>
  <!-- Chapter Narrative Intro -->
  <blockquote lang="en" class="text-center font-serif italic text-lg sm:text-xl text-[var(--teks)] max-w-xl mx-auto mb-10 font-light">
    "The day ended in colors no camera could get right."
  </blockquote>

  <!-- Warm Fajar Atmosphere Note -->
  <div class="w-full max-w-xl mx-auto mb-8 p-4 rounded-lg bg-orange-100 border border-orange-200 shadow-xs flex flex-wrap gap-3 items-center justify-between text-base font-mono text-orange-950">
    <span class="flex items-center gap-1.5">
      <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
      Cahaya Senja
    </span>
    <span>Menjelang malam</span>
    <span>Horison barat</span>
  </div>

  <!-- Interactive React Island Galeri -->
  <Galeri
    client:visible
    slides={slides}
    tampil="keduanya"
    background="transparent"
    ink="#FFF4E0"
    string="#C2410C"
    ariaLabel="Galeri Foto Sunset Gunung Andong"
  />
</Bab>
