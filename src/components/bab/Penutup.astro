---
import Bab from "../Bab.astro";
import { responsiveImage } from "../../lib/media";

interface Props {
  coverPhoto?: string;
}

const { coverPhoto = "/foto/penutup-cover.jpg" } = Astro.props;
const imgProps = responsiveImage(coverPhoto.includes("/responsive/") ? "/foto/penutup-cover.jpg" : coverPhoto);
---

<Bab
  id="penutup"
  nomor="06"
  nama="Penutup"
  subjudul="Before Heading Down"
  elevasi="1.726 mdpl"
  tema="penutup"
  className="min-h-[85vh] flex flex-col justify-between"
>
  <div class="max-w-3xl mx-auto text-center my-auto flex flex-col items-center p-6 sm:p-10 rounded-3xl bg-slate-950 border border-amber-300/30 shadow-2xl">
    <h3 lang="en" class="penutup-stagger font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-amber-200 tracking-tight mb-4">
      Glad we came.
    </h3>

    <p lang="en" class="penutup-stagger font-sans text-base text-amber-100 max-w-lg font-normal leading-relaxed mb-8">
      A good hike, and good company. Until the next one.
    </p>

    <!-- Single Final Starlit Polaroid Feature -->
    <div class="penutup-stagger relative w-64 sm:w-72 bg-[#fbfaf7] p-3 pb-6 rounded-sm shadow-2xl rotate-1 hover:rotate-0 transition duration-500 mb-10 group">
      <div class="aspect-square overflow-hidden bg-stone-900 rounded-[1px]">
        <img
          src={imgProps.image}
          srcset={imgProps.srcSet}
          sizes="(max-width: 640px) 256px, 288px"
          width="600"
          height="600"
          alt="Kenangan penutup pendakian Gunung Andong"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
        />
      </div>
      <p class="font-serif italic text-base text-stone-900 text-center mt-3">
        Andong, Berdua.
      </p>
    </div>

    <!-- Doorway to Secret Page -->
    <div class="penutup-stagger p-6 rounded-xl bg-stone-900 border border-amber-300/30 max-w-md w-full mb-12">
      <p class="text-base font-mono text-amber-200 uppercase tracking-widest mb-3">
        Halaman Khusus
      </p>
      <a
        id="btn-buka-rahasia"
        href="/rahasia"
        class="min-h-11 inline-flex items-center justify-center gap-2 w-full py-3 px-6 rounded-lg bg-amber-400 hover:bg-amber-300 text-stone-950 font-sans font-semibold text-base transition duration-200 shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-200"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Buka Bagian Pribadi
      </a>
      <span class="block text-xs text-amber-100 mt-2.5 font-mono">
        (Khusus untuk kita berdua • Masukkan kata sandi)
      </span>
    </div>

    <!-- Authentic Project Credits (PRD §5) -->
    <footer class="w-full border-t border-white/20 pt-8 mt-4 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left text-xs font-mono text-amber-100">
      <div>
        <span class="block text-amber-300 uppercase tracking-wider mb-1 font-semibold">Dokumentasi</span>
        <p lang="en" class="text-amber-100 font-sans text-base">A hiking album by Ridho.</p>
      </div>
      <div>
        <span class="block text-amber-300 uppercase tracking-wider mb-1 font-semibold">Teknologi</span>
        <p lang="en" class="text-amber-100 font-sans text-base">Astro, React Island, Tailwind CSS, & GSAP.</p>
      </div>
      <div>
        <span class="block text-amber-300 uppercase tracking-wider mb-1 font-semibold">Kode Sumber</span>
        <a href="https://github.com/M-Ridho-Firmansyah/Album-Andong" target="_blank" rel="noopener noreferrer" class="hover:underline text-amber-200 text-sm inline-block py-1">
          github.com/M-Ridho-Firmansyah/Album-Andong ↗
        </a>
      </div>
    </footer>
  </div>
</Bab>
