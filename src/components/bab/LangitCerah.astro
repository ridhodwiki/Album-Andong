---
import mediaData from "../../data/media.json";
import Bab from "../Bab.astro";
import Galeri from "../Galeri";
import type { Slide } from "../ui/polaroid-line-carousel";

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const bab = mediaData.find(b => b.id === "langit-cerah")!;

---

<Bab
  id="langit-cerah"
  nomor="04"
  nama="Langit Cerah"
  subjudul={bab.subjudul}
  elevasi="1.726 mdpl"
  tema="langit"
  className="relative"
>
  <!-- Decorative Sun Rays & Lens Flare (CSS/SVG without 3D library, PRD §7 & F12) -->
  <div class="sky-light" aria-hidden="true">
    <svg
      id="langit-sun-rays"
      viewBox="0 0 200 200"
      class="absolute -top-20 -right-20 w-72 h-72 sm:w-96 sm:h-96 opacity-35 text-amber-400 pointer-events-none"
    >
      <circle cx="100" cy="100" r="28" fill="currentColor" opacity="0.35" />
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="100" y1="8" x2="100" y2="48" />
        <line x1="100" y1="152" x2="100" y2="192" />
        <line x1="8" y1="100" x2="48" y2="100" />
        <line x1="152" y1="100" x2="192" y2="100" />
        <line x1="35" y1="35" x2="63" y2="63" />
        <line x1="137" y1="137" x2="165" y2="165" />
        <line x1="165" y1="35" x2="137" y2="63" />
        <line x1="63" y1="137" x2="35" y2="165" />
      </g>
    </svg>
    <div
      id="langit-flare"
      class="hidden md:block absolute top-1/4 left-1/3 w-48 h-48 rounded-full bg-amber-200/30 blur-2xl pointer-events-none"
    ></div>
  </div>

  <div class="relative z-10 w-full flex flex-col items-center">
    <blockquote lang="en" class="text-center font-serif italic text-lg sm:text-xl text-[var(--teks)] max-w-xl mx-auto mb-10 font-light">{bab.kutipan}</blockquote>

    <!-- Horizon Silhouette Panorama Card -->
    <div class="w-full max-w-3xl mx-auto mb-12 p-5 rounded-xl bg-white/85 border border-sky-900/20 shadow-sm text-center">
      <div class="flex justify-around items-end h-20 px-2 sm:px-4 border-b border-sky-900/20 pb-3">
        <div class="flex flex-col items-center">
          <span class="w-8 h-8 rounded-full bg-sky-200 mb-1" aria-hidden="true"></span>
          <span class="text-xs font-mono text-slate-900 font-semibold">G. Telomoyo</span>
          <span class="text-xs font-mono text-slate-700">Utara</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="w-10 h-10 rounded-full bg-sky-300 mb-1" aria-hidden="true"></span>
          <span class="text-xs font-mono text-slate-950 font-bold">G. Merbabu 3.145 mdpl</span>
          <span class="text-xs font-mono text-slate-700">Selatan</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="w-9 h-9 rounded-full bg-sky-200 mb-1" aria-hidden="true"></span>
          <span class="text-xs font-mono text-slate-900 font-semibold">G. Merapi</span>
          <span class="text-xs font-mono text-slate-700">Tenggara</span>
        </div>
      </div>
      <p lang="en" class="text-base text-slate-900 font-sans mt-3 font-normal">
        {bab.narasi?.[0]}
      </p>
    </div>

    <!-- Authentic Field Conversation Quote Card -->
    <div class="w-full max-w-2xl mx-auto mb-10 p-5 rounded-lg bg-white/85 border border-sky-900/20 shadow-xs text-slate-900 space-y-2">
      <p lang="en" class="font-serif italic text-base text-slate-900">
        {bab.narasi?.[1]}
      </p>
      <p lang="en" class="font-serif italic text-base text-sky-950 font-medium">
        {bab.narasi?.[2]}
      </p>
      <p lang="en" class="font-serif italic text-base text-slate-900">
        {bab.narasi?.[3]}
      </p>
    </div>

    <!-- Interactive React Island Galeri -->
    <Galeri
      client:visible
      slides={slides}
      tampil="keduanya"
      background="transparent"
      ink="#0F172A"
      string="#0F4C5C"
      ariaLabel="Galeri Foto Langit Cerah Gunung Andong"
    />
  </div>
</Bab>
