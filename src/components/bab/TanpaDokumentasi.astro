---
import mediaData from "../../data/media.json";
import Bab from "../Bab.astro";
const bab = mediaData.find(b => b.id === "tanpa-dokumentasi")!;

---

<Bab
  id="tanpa-dokumentasi"
  nomor="02"
  nama="Tanpa Dokumentasi"
  subjudul={bab.subjudul}
  elevasi="1.680 mdpl"
  tema="gelap"
  className="min-h-svh flex flex-col justify-center"
>
  <div id="tanpa-dok-box" class="max-w-2xl mx-auto text-center my-auto flex flex-col items-center gap-6 py-12 px-6 sm:px-10 rounded-3xl bg-stone-950 border border-white/20 shadow-2xl">
    <!-- Trail Incline Graphic -->
    <div class="w-full max-w-xs mb-2" aria-hidden="true">
      <svg viewBox="0 0 200 40" class="w-full h-10 overflow-visible text-[#E8C872]">
        <path id="tanpa-dok-path" d="M 10 35 L 70 28 L 130 15 L 190 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="10" cy="35" r="3" fill="currentColor" />
        <circle cx="70" cy="28" r="3" fill="currentColor" />
        <circle cx="130" cy="15" r="3" fill="currentColor" />
        <circle id="tanpa-dok-dot" cx="190" cy="5" r="4" fill="currentColor" />
      </svg>
      <div class="flex justify-between text-xs font-mono tracking-wider text-stone-200 mt-2">
        <span>Tanjakan Terjal</span>
        <span>Menjelang Punggung</span>
      </div>
    </div>

    <!-- Bold Honest Typographic Narrative -->
    <div class="space-y-4">
      <p lang="en" class="tanpa-dok-line font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-[#F4F1E8] tracking-tight leading-tight data-muncul">
        {bab.narasi?.[0]}
      </p>
      <p lang="en" class="tanpa-dok-line font-serif text-2xl sm:text-3xl md:text-4xl font-light text-stone-200 leading-snug data-muncul">
        {bab.narasi?.[1]}
      </p>
      <p lang="en" class="tanpa-dok-line font-serif italic text-xl sm:text-2xl md:text-3xl text-[#E8C872] font-light mt-4 data-muncul">
        {bab.narasi?.[2]}
      </p>
    </div>

    <p lang="en" class="tanpa-dok-line font-sans text-base text-stone-200 max-w-md font-normal leading-relaxed mt-4">
      {bab.narasi?.[3]}
    </p>

    <div class="mt-6 flex flex-wrap justify-center items-center gap-4 text-xs font-mono text-stone-200">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#E8C872]"></span>
        Status: Saling berpegang jaket
      </span>
      <span aria-hidden="true">•</span>
      <span>Jarak: 2,4 km</span>
    </div>
  </div>
</Bab>
