---
import Bab from "../Bab.astro";
---

<Bab
  id="tanpa-dokumentasi"
  nomor="02"
  nama="Tanpa Dokumentasi"
  subjudul="No photos from this stretch"
  elevasi="1.680 mdpl"
  tema="gelap"
  className="min-h-[75vh] flex flex-col justify-center"
>
  <div class="max-w-2xl mx-auto text-center my-auto flex flex-col items-center gap-6 py-12 px-6 sm:px-10 rounded-3xl bg-stone-900/85 backdrop-blur-md border border-white/10 shadow-2xl">
    <!-- Trail Incline Graphic -->
    <div class="w-full max-w-xs mb-2" aria-hidden="true">
      <svg viewBox="0 0 200 40" class="w-full h-10 overflow-visible text-amber-300/80">
        <path d="M 10 35 L 70 28 L 130 15 L 190 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <circle cx="10" cy="35" r="3" fill="currentColor" />
        <circle cx="70" cy="28" r="3" fill="currentColor" />
        <circle cx="130" cy="15" r="3" fill="currentColor" />
        <circle cx="190" cy="5" r="4" fill="currentColor" class="animate-ping" />
      </svg>
      <div class="flex justify-between text-[10px] font-mono tracking-wider text-stone-400 mt-2">
        <span>Tanjakan Terjal</span>
        <span>Menjelang Punggung</span>
      </div>
    </div>

    <!-- Bold Honest Typographic Narrative -->
    <div class="space-y-4">
      <p class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-white tracking-tight leading-tight data-muncul">
        "No photos from this stretch."
      </p>
      <p class="font-serif text-2xl sm:text-3xl md:text-4xl font-light text-stone-300 leading-snug data-muncul">
        "We needed a breather."
      </p>
      <p class="font-serif italic text-xl sm:text-2xl md:text-3xl text-amber-300/90 font-light mt-4 data-muncul">
        "It was steeper than it looked."
      </p>
    </div>

    <p class="font-sans text-xs sm:text-sm text-stone-400 max-w-md font-light leading-relaxed mt-6">
      Just footsteps on gravel and a few stops to catch our breath.
    </p>

    <div class="mt-8 flex items-center gap-6 text-xs font-mono text-stone-400">
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        Status: Saling berpegang jaket
      </span>
      <span>•</span>
      <span>Jarak: 2,4 km</span>
    </div>
  </div>
</Bab>
