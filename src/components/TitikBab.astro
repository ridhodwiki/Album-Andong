---
const babList = [
  { id: "pembuka", label: "00. Pembuka" },
  { id: "sabana", label: "01. Sabana" },
  { id: "tanpa-dokumentasi", label: "02. Jalur Gelap" },
  { id: "puncak", label: "03. Puncak" },
  { id: "langit-cerah", label: "04. Langit Cerah" },
  { id: "sunrise", label: "05. Sunrise" },
  { id: "penutup", label: "06. Penutup" },
];
---

<nav
  class="fixed right-6 top-1/2 -translate-y-1/2 z-40 hidden md:flex flex-col items-end gap-3 select-none"
  aria-label="Daftar Bab Pendakian"
>
  {babList.map((bab) => (
    <a
      href={`#${bab.id}`}
      class="nav-dot-item group flex items-center gap-2.5 py-1 px-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 rounded"
      data-target={bab.id}
      aria-label={bab.label}
    >
      <span aria-hidden="true" class="text-xs font-sans font-medium px-2 py-0.5 rounded bg-stone-950/90 text-amber-100 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-200 tracking-wide translate-x-1 group-hover:translate-x-0">
        {bab.label}
      </span>
      <span class="dot-indicator w-3 h-3 rounded-full bg-stone-950/70 border border-amber-200/80 transition-all duration-300 group-hover:scale-125 group-hover:bg-amber-300"></span>
    </a>
  ))}
</nav>

<script>
  function highlightActiveDot() {
    const dots = document.querySelectorAll<HTMLAnchorElement>(".nav-dot-item");
    const sections = Array.from(dots).map(d => {
      const id = d.getAttribute("data-target");
      return id ? document.getElementById(id) : null;
    });

    const scrollY = window.scrollY + window.innerHeight * 0.35;

    sections.forEach((sec, idx) => {
      if (!sec) return;
      const top = sec.offsetTop;
      const bottom = top + sec.offsetHeight;
      const dot = dots[idx]?.querySelector(".dot-indicator");

      if (scrollY >= top && scrollY < bottom) {
        dot?.classList.add("!bg-amber-400", "!border-amber-200", "!scale-125", "!w-3", "!h-3");
      } else {
        dot?.classList.remove("!bg-amber-400", "!border-amber-200", "!scale-125", "!w-3", "!h-3");
      }
    });
  }

  window.addEventListener("scroll", highlightActiveDot, { passive: true });
  highlightActiveDot();
</script>
