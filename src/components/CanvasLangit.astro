---
// Canvas 2D Efek Langit Cerah: Partikel cahaya matahari & kabut fajar ringan
// Ukuran < 2KB, berhenti otomatis saat di luar layar, tanpa library 3D berat
---

<div class="canvas-langit-container absolute inset-0 pointer-events-none overflow-hidden z-0 opacity-70">
  <canvas id="canvas-langit" class="w-full h-full block"></canvas>
</div>

<script>
  function initCanvasLangit() {
    const canvas = document.getElementById("canvas-langit") as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    let w = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
    let h = (canvas.height = canvas.parentElement?.clientHeight || window.innerHeight);

    window.addEventListener("resize", () => {
      w = canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
      h = canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
    });

    const numParticles = window.innerWidth < 768 ? 25 : 55;
    const particles = Array.from({ length: numParticles }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 2.5 + 1,
      vx: (Math.random() - 0.5) * 0.35,
      vy: -Math.random() * 0.45 - 0.15,
      alpha: Math.random() * 0.6 + 0.2,
    }));

    let isVisible = true;
    let raf: number;

    function render() {
      if (!ctx || !isVisible) return;
      ctx.clearRect(0, 0, w, h);

      // Soft ambient sun glow at top center
      const gradient = ctx.createRadialGradient(w * 0.5, 0, 10, w * 0.5, 0, h * 0.85);
      gradient.addColorStop(0, "rgba(255, 245, 210, 0.25)");
      gradient.addColorStop(0.5, "rgba(224, 242, 254, 0.12)");
      gradient.addColorStop(1, "rgba(255, 255, 255, 0)");
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, w, h);

      // Particles
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.y < 0) {
          p.y = h;
          p.x = Math.random() * w;
        }
        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 248, 220, ${p.alpha})`;
        ctx.fill();
      }

      raf = requestAnimationFrame(render);
    }

    const observer = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
      if (isVisible) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(render);
      }
    });

    observer.observe(canvas);
    raf = requestAnimationFrame(render);
  }

  document.addEventListener("DOMContentLoaded", initCanvasLangit);
</script>
