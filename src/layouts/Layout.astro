---
import "../styles/global.css";
import RelKetinggian from "../components/RelKetinggian.astro";
import TitikBab from "../components/TitikBab.astro";
import MusikToggle from "../components/MusikToggle.astro";
import VantaCloudsGlobal from "../components/VantaCloudsGlobal.astro";
import BahasaToggle from "../components/BahasaToggle.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Andong, Berdua — Album Kenangan Pendakian",
  description = "Album digital kenangan pendakian Gunung Andong 1.726 mdpl. Menembus dingin, menyusuri sabana, dan menyapa fajar berdua.",
  image = "/foto/pembuka-hero.jpg",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      const connection = navigator.connection;
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches || new URLSearchParams(location.search).get("ringan") === "1" || connection?.saveData || /^(slow-2g|2g|3g)$/.test(connection?.effectiveType || "");
      document.documentElement.dataset.motion = calm ? "calm" : "full";
      document.documentElement.dataset.ringan = String(calm);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Social Sharing Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="bg-transparent text-slate-900 antialiased selection:bg-amber-400 selection:text-stone-950 min-h-screen relative">
    <!-- 3D Vanta Clouds Background (Global Deploy Look) -->
    <VantaCloudsGlobal />
    <BahasaToggle />

    <div class="fixed bottom-4 right-4 z-40">
      <a id="mode-link" href="?ringan=1" class="h-11 inline-flex items-center justify-center rounded-full bg-stone-950/90 hover:bg-stone-950 border border-white/25 px-4 text-xs font-mono font-medium leading-none text-white shadow-xl backdrop-blur-md transition">Versi ringan</a>
    </div>

    <!-- Accessible Skip to Content -->
    <a
      href="#konten-utama"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-amber-400 focus:text-stone-900 focus:rounded-md focus:font-medium"
    >
      Lewati ke konten utama
    </a>

    <!-- Global Floating Mountain Elements -->
    <MusikToggle />
    {Astro.url.pathname === "/" && <><RelKetinggian /><TitikBab /></>}

    <main id="konten-utama" class="relative z-10">
      <slot />
    </main>

    <script>
      import { isLightMode } from "../lib/gerak";

      // I18n Logic
      const STORAGE_KEY = "andong-lang";
      let currentLang = localStorage.getItem(STORAGE_KEY) || "id";
      let translations: Record<string, any> = {};

      async function loadTranslations(lang: string) {
        try {
          const res = await fetch(`/data/media.${lang}.json`);
          const data = await res.json();
          translations = data.reduce((acc: any, bab: any) => {
            acc[bab.id] = bab;
            return acc;
          }, {});
          updateUI();
        } catch (e) {
          console.error("Failed to load translations", e);
        }
      }

      function updateUI() {
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const [babId, key, index] = (el as HTMLElement).dataset.i18n?.split(".") || [];
          if (!babId || !translations[babId]) return;

          let val = translations[babId][key];
          if (index !== undefined && Array.isArray(val)) val = val[parseInt(index)];

          if (val) el.textContent = val;
        });

        // Update items in galleries (handled by React)
        document.dispatchEvent(new CustomEvent("lang-data-ready", { detail: { translations } }));
      }

      document.addEventListener("lang-change", (e: any) => {
        currentLang = e.detail.lang;
        void loadTranslations(currentLang);
      });

      // Init
      void loadTranslations(currentLang);

      const preference = matchMedia("(prefers-reduced-motion: reduce)");
      let dispose: (() => void) | undefined;
      let loading = false;
      const update = async () => {
        const calm = isLightMode();
        document.documentElement.dataset.ringan = String(calm);
        document.documentElement.dataset.motion = calm ? "calm" : "full";
        const link = document.getElementById("mode-link") as HTMLAnchorElement | null;
        if (link) { link.href = calm ? "?ringan=0" : "?ringan=1"; link.textContent = calm ? "Versi normal" : "Versi ringan"; }
        if (calm || dispose || loading || !document.getElementById("pembuka")) return;
        loading = true;
        try { const { initScroll } = await import("../lib/scroll"); if (!isLightMode()) dispose = initScroll(); }
        catch { document.documentElement.dataset.motion = "calm"; }
        finally { loading = false; }
      };
      preference.addEventListener("change", update);
      window.addEventListener("pagehide", () => { dispose?.(); dispose = undefined; });
      window.addEventListener("pageshow", () => { void update(); });
      void update();
    </script>
  </body>
</html>
