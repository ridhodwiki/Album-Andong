---
import "../styles/global.css";
import RelKetinggian from "../components/RelKetinggian.astro";
import TitikBab from "../components/TitikBab.astro";
import MusikToggle from "../components/MusikToggle.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Andong, Berdua — Album Kenangan Pendakian",
  description = "Album digital kenangan pendakian Gunung Andong 1.726 mdpl. Menembus dingin, menyusuri sabana, dan menyapa fajar berdua.",
  image = "/foto/pembuka-hero.jpg",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      const connection = navigator.connection;
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches || new URLSearchParams(location.search).get("ringan") === "1" || connection?.saveData || /^(slow-2g|2g|3g)$/.test(connection?.effectiveType || "");
      document.documentElement.dataset.motion = calm ? "calm" : "full";
      document.documentElement.dataset.ringan = String(calm);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Preload LCP Hero Image (PRD §10 & Gerbang 4) -->
    <link
      rel="preload"
      as="image"
      href="/foto/responsive/pembuka-hero-1200.webp"
      imagesrcset="/foto/responsive/pembuka-hero-600.webp 600w, /foto/responsive/pembuka-hero-1200.webp 1200w, /foto/responsive/pembuka-hero-1920.webp 1920w"
      imagesizes="100vw"
      fetchpriority="high"
    />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Social Sharing Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="bg-transparent text-[#F4F1E8] antialiased selection:bg-amber-400 selection:text-stone-950 min-h-screen relative">
    <div class="fixed bottom-4 right-4 z-40">
      <a href="?ringan=1" class="rounded-full bg-stone-950 px-4 py-3 text-base text-white shadow-lg">Versi ringan</a>
    </div>

    <!-- Accessible Skip to Content -->
    <a
      href="#konten-utama"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-amber-400 focus:text-stone-900 focus:rounded-md focus:font-medium"
    >
      Lewati ke konten utama
    </a>

    <!-- Global Floating Mountain Elements -->
    <MusikToggle />
    {Astro.url.pathname === "/" && <><RelKetinggian /><TitikBab /></>}

    <main id="konten-utama" class="relative z-10">
      <slot />
    </main>

    <script>
      import "../lib/scroll";
    </script>
  </body>
</html>
